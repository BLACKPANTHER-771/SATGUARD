# ==============================================================================
# EPOCH - Early Warning & Landslide Risk Monitoring Environment Configuration
# All variables are OPTIONAL: The application runs with 100% full fidelity
# in synthetic demonstration mode if any or all tokens are omitted.
# ==============================================================================

# 1. OpenWeather API Key (Optional)
# If provided, fetches live meteorological conditions for Sikkim and Assam monitoring sectors.
# If omitted or invalid, EPOCH gracefully falls back to synthetic high-resolution regional weather profiles.
VITE_OPENWEATHER_API_KEY=

# 2. Cesium Ion Access Token (Optional)
# If provided, enables Cesium World Terrain and OSM 3D Buildings streaming in the 3D Earth GIS.
# If omitted or invalid, EPOCH gracefully falls back to WGS84 Ellipsoid baseline terrain and transparent hazard footprint polygons without unhandled rejections.
VITE_CESIUM_ION_TOKEN=

# 3. Backend API Base URL (Optional)
# Leave empty for pure static/standalone client deployments (e.g., Vercel / GitHub Pages).
# Set to 'http://localhost:8000' or your remote API gateway only if running the optional Python FastAPI backend.
VITE_API_BASE_URL=

