# ==============================================================================
# EPOCH Backend - Production & Integration Environment Variables
# All variables are OPTIONAL: The application operates in high-fidelity
# simulation / demonstration mode if credentials are not provided.
# ==============================================================================

# 1. Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=production
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,http://localhost:3000

# 2. Database (Optional - defaults to persistent JSON / SQLite fallback)
DATABASE_URL=

# 3. Copernicus Data Space Ecosystem (CDSE) OAuth Credentials (Optional)
# If provided, enables live Sentinel-1 C-SAR catalogue querying via CDSE OData API.
# If omitted, CopernicusService falls back to safe demonstration metadata.
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=

# 4. SMS Provider Gateway (Optional)
# If provided, enables live SMS dispatch to registered emergency responders.
# If omitted, SMSOrchestrator runs in DRY_RUN mode with full transparency.
SMS_PROVIDER_TYPE=dry-run
SMS_API_URL=
SMS_API_KEY=
SMS_AUTH_TOKEN=
SMS_SENDER_ID=EPOCH
